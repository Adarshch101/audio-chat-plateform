# Server Port Configuration
PORT=5000

# --- Persistence -----------------------------------------------------------------
# Sessions + reports are stored in MongoDB. If MongoDB is unreachable (or not
# selected), the server falls back to JSON files under DATA_DIR.
#   PERSISTENCE=auto     (default) — use MongoDB whenever MONGODB_URI is set
#   PERSISTENCE=mongodb             — force MongoDB (defaults to localhost:27017)
#   PERSISTENCE=file                — force JSON file storage under DATA_DIR
PERSISTENCE=auto
MONGODB_URI=
MONGODB_DB=health_voice_agent

# Directory used by the JSON file fallback backend
DATA_DIR=./data

# --- Optional security controls -------------------------------------------------
# When set, both the REST API and WebSocket connections require this bearer
# token (Authorization: Bearer <token> for REST, ?token=<token> for WS).
# Leave empty to disable auth for local development.
API_AUTH_TOKEN=

# Comma-separated list of allowed browser origins (CORS).
# Defaults to http://localhost:5173, 5174, 3000 when not set.
ALLOWED_ORIGINS=

# Max API requests per IP per 60s sliding window.
RATE_LIMIT_MAX=300

# Deepgram API Credentials for Speech-to-Text (STT)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# STT model + language mode. Defaults enable in-stream language auto-detection:
# Nova-3 "multi" transcribes English AND Hindi in the same stream, and the
# session language switches automatically based on what the user says/types.
#   STT_MODEL=nova-3     (nova-2 supported but "multi" only covers EN/ES there)
#   STT_LANGUAGE=multi   (pin to "en" or "hi" to disable auto-detection)
STT_MODEL=nova-3
STT_LANGUAGE=multi

# OpenAI API Credentials for Conversational AI Agent (fallback LLM provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional secondary OpenAI model used if OPENAI_MODEL fails or rate-limits.
OPENAI_FALLBACK_MODEL=

# Groq API Credentials for Conversational AI Agent (primary LLM provider)
# When GROQ_API_KEY is set, Groq is used instead of OpenAI.
GROQ_API_KEY=your_groq_api_key_here
# llama-3.3-70b-versatile is recommended for reliable structured extraction.
# llama-3.1-8b-instant is faster/cheaper but can lag or repeat questions verbatim.
GROQ_MODEL=llama-3.3-70b-versatile
# Automatic failover when GROQ_MODEL is rate-limited or quota-exhausted (e.g.
# the free-tier daily token cap). Try the next model instead of dead-ending
# the call into the generic "please repeat" fallback.
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# ElevenLabs API Credentials for Text-to-Speech (TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional language-specific voice identifiers
ELEVENLABS_ENGLISH_VOICE_ID=
ELEVENLABS_HINDI_VOICE_ID=

# Developer Chaos Testing Simulation Switches (Default: false)
SIMULATE_STT_FAILURE=false
SIMULATE_LLM_FAILURE=false
SIMULATE_TTS_FAILURE=false
SIMULATE_REPORT_FAILURE=false
